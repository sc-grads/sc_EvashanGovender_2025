<Window x:Class="StudentRegistrationProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudentRegistrationProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="3,5,-3,-5" Background="#FF4D899A">
        <Label Content="StudentID" HorizontalAlignment="Left" Margin="56,11,0,0" VerticalAlignment="Top" Height="38" Width="170" FontSize="16" RenderTransformOrigin="0.494,0.637"/>
        <Label Content="Name" HorizontalAlignment="Left" Margin="56,80,0,0" VerticalAlignment="Top" Height="41" Width="170" FontSize="16"/>
        <Label Content="Surname" HorizontalAlignment="Left" Margin="56,144,0,0" VerticalAlignment="Top" Height="38" FontSize="16" Width="170" RenderTransformOrigin="0.502,0.505"/>
        <Label Content="Address" HorizontalAlignment="Left" Margin="56,201,0,0" VerticalAlignment="Top" Height="38" FontSize="16" Width="170"/>
        <Label Content="City" HorizontalAlignment="Left" Margin="56,258,0,0" VerticalAlignment="Top" Height="38" FontSize="16" Width="170" RenderTransformOrigin="0.473,0.479"/>
        <Label Content="Cell Phone" HorizontalAlignment="Left" Margin="56,319,0,0" VerticalAlignment="Top"  FontSize="16" Height="38" Width="170"/>
        <TextBox x:Name="txtID" HorizontalAlignment="Left" Margin="231,11,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Margin="231,80,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <TextBox x:Name="txtSurname" HorizontalAlignment="Left" Margin="231,144,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <TextBox x:Name="txtAddress" HorizontalAlignment="Left" Margin="231,201,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <TextBox x:Name="txtCity" HorizontalAlignment="Left" Margin="231,258,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <TextBox x:Name="txtCellphone" HorizontalAlignment="Left" Margin="231,319,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="359" Height="38"/>
        <Button Content="Register" HorizontalAlignment="Left" Margin="335,378,0,0" VerticalAlignment="Top" Height="46" Width="158" FontSize="20" Background="#FF9FE090" Click="Button_Click"/>
        <Button Content="Delete" HorizontalAlignment="Left" Margin="693,378,0,0" VerticalAlignment="Top" Height="46" Width="83" FontSize="20" Background="#FFDF2D18" Click="Delete"/>
        <Button Content="Update" HorizontalAlignment="Left" Margin="579,378,0,0" VerticalAlignment="Top" Height="46" Width="92" FontSize="20" Background="#FFE87B1B" Click="Update"/>
        <Button Content="Read Data" HorizontalAlignment="Left" Margin="10,378,0,0" VerticalAlignment="Top" Height="46" Width="158" FontSize="20" Background="#FF1E70F3" Click="Read"/>

    </Grid>
</Window>
