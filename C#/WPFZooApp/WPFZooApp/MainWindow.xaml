<Window x:Class="WPFZooApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFZooApp"
        mc:Ignorable="d"
        Title="ZooManager" Height="500" Width="725">
    <Grid>
        <Label Content="Zoo List" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.524,0.599" Height="34" Width="81"/>
        <ListBox x:Name="ListZoos" Margin="10,44,569,242" SelectionChanged="ListZoos_SelectionChanged"/>
        <ListBox x:Name="listAssociatedAnimals" Margin="188,44,391,242"/>
        <Label Content="Associated Animals List" HorizontalAlignment="Left" Margin="188,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.524,0.599" Height="34" Width="146"/>
        <ListBox x:Name="listAnimals" Margin="393,44,186,149" SelectionChanged="ListAnimals_SelectionChanged"/>
        <Button Content="Delete Zoo" Click="DeleteZoo"  HorizontalAlignment="Left" Margin="11,247,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29"/>
        <Button Content="Delete Animal" HorizontalAlignment="Left" Margin="188,247,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="146" Height="29"/>
        <Button Content="Add Zoo" Click="AddZoo_Click"  HorizontalAlignment="Left" Margin="11,348,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29"/>
        <Button Content="Update Zoo" HorizontalAlignment="Left" Margin="11,397,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29" Click="UpdateZoo_Click"/>
        <Button Content="Add Animal" Click="AddAnimal_Click" HorizontalAlignment="Left" Margin="189,348,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29"/>
        <Button Content="Update Animal" Click="UpdateAnimal_Click" HorizontalAlignment="Left" Margin="188,397,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29"/>
        <Button Content="Delete Animal" Click="DeleteAnimal_Click" HorizontalAlignment="Left" Margin="393,362,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="146" Height="30"/>
        <Button Content="Add Animal to Zoo" Click="AddAnimalToZoo_Click" HorizontalAlignment="Left" Margin="393,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.065,-0.814" Width="145" Height="29"/>
        <TextBox x:Name="Zootxt"  HorizontalAlignment="Left" Margin="11,298,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="323" Height="37"/>

    </Grid>
</Window>
